#update package from experimental-unstable-testing-current
#usage: getpack "package1 package2..." max_level #1-testing, 2-unstable, 3-experimental
getpack() {
  local pack=$1
  local maxlvl="${2:-0}"
  DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::="--force-confnew" -o Dpkg::Options::="--force-overwrite" install $pack
  if [ $maxlvl -ge 1 ]; then
    DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::="--force-confnew" -o Dpkg::Options::="--force-overwrite" -t testing install $pack
  fi
  if [ $maxlvl -ge 2 ]; then
    DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::="--force-confnew" -o Dpkg::Options::="--force-overwrite" -t unstable install $pack
  fi
  if [ $maxlvl -ge 3 ]; then
    DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::="--force-confnew" -o Dpkg::Options::="--force-overwrite" -t experimental install $pack
  fi
}

#reinstall package from experimental-unstable-testing-current
#usage: forcepack "package1 package2..." max_level #1-testing, 2-unstable, 3-experimental
forcepack() {
  local pack=$1
  local maxlvl="${2:-0}"
  echo "$pack"
  apt show $pack
  echo 'DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::="--force-confnew" reinstall ${pack}'
  DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::="--force-confnew" -o Dpkg::Options::="--force-overwrite" reinstall $pack
  apt show $pack
  if [ $maxlvl -ge 1 ]; then
    echo 'DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::="--force-confnew" -t testing reinstall $pack'
    DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::="--force-confnew" -o Dpkg::Options::="--force-overwrite" -t testing reinstall $pack
    apt show $pack
  fi
  if [ $maxlvl -ge 2 ]; then
    echo 'DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::="--force-confnew" -t unstable reinstall $pack'
    DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::="--force-confnew" -o Dpkg::Options::="--force-overwrite" -t unstable reinstall $pack
    apt show $pack
  fi
  if [ $maxlvl -ge 3 ]; then
    echo 'DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::="--force-confnew" -t experimental reinstall $pack'
    DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::="--force-confnew" -o Dpkg::Options::="--force-overwrite" -t experimental reinstall $pack
    apt show $pack
  fi
}