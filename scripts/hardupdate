#update package from experimental-unstable-testing-current
#usage: getpack "package1 package2..." max_level #1-testing, 2-unstable, 3-experimental
getpack() {
  local pack=$1
  local maxlvl="${2:-0}"
  DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::="--force-confnew" install $pack
  if [ $maxlvl -ge 1 ]; then
    DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::="--force-confnew" -t testing install $pack
  fi
  if [ $maxlvl -ge 2 ]; then
    DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::="--force-confnew" -t unstable install $pack
  fi
  if [ $maxlvl -ge 3 ]; then
    DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::="--force-confnew" -t experimental install $pack
  fi
}

#reinstall package from experimental-unstable-testing-current
#usage: forcepack "package1 package2..." max_level #1-testing, 2-unstable, 3-experimental
forcepack() {
  local pack=$1
  local maxlvl="${2:-0}"
  DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::="--force-confnew" reinstall $pack
  if [ $maxlvl -ge 1 ]; then
    DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::="--force-confnew" -t testing reinstall $pack
  fi
  if [ $maxlvl -ge 2 ]; then
    DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::="--force-confnew" -t unstable reinstall $pack
  fi
  if [ $maxlvl -ge 3 ]; then
    DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::="--force-confnew" -t experimental reinstall $pack
  fi
}